# 按 #t wp_idx 追加一条 FX（val 取 #t wp_val）
execute if score #t wp_idx matches 1 run function plm:weapon/affix/append/fx_1
execute if score #t wp_idx matches 2 run function plm:weapon/affix/append/fx_2
execute if score #t wp_idx matches 3 run function plm:weapon/affix/append/fx_3
execute if score #t wp_idx matches 4 run function plm:weapon/affix/append/fx_4
execute if score #t wp_idx matches 5 run function plm:weapon/affix/append/fx_5
execute if score #t wp_idx matches 6 run function plm:weapon/affix/append/fx_6
execute if score #t wp_idx matches 7 run function plm:weapon/affix/append/fx_7
execute if score #t wp_idx matches 8 run function plm:weapon/affix/append/fx_8
execute if score #t wp_idx matches 9 run function plm:weapon/affix/append/fx_9
execute if score #t wp_idx matches 10 run function plm:weapon/affix/append/fx_10
