# 影域镇设施在离线地图marker预留的落点安装；所有设施函数均可重复执行。
execute in minecraft:overworld at @e[type=marker,tag=plm_shadow_forge,limit=1] unless block ~ ~ ~ minecraft:dropper run setblock ~ ~ ~ minecraft:dropper[facing=up] replace
execute in minecraft:overworld at @e[type=marker,tag=plm_shadow_forge,limit=1] unless entity @e[type=interaction,tag=plm_shadow_forge_use,distance=..2,limit=1] run summon interaction ~1 ~0.5 ~ {Tags:["plm_shadow_forge_use"],width:0.8f,height:1.2f,response:1b,Passengers:[{id:"minecraft:text_display",billboard:"center",alignment:"center",transformation:{translation:[0f,0.5f,0f],scale:[0.8f,0.8f,0.8f],left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f]},text:'{"text":"磨镜台 · 放料后点击","color":"aqua"}'}]}
execute in minecraft:overworld at @e[type=marker,tag=plm_shadow_exit_spot,limit=1] unless entity @e[type=interaction,tag=plm_shadow_exit,distance=..2,limit=1] run summon interaction ~ ~ ~ {Tags:["plm_shadow_exit"],width:1.2f,height:1.6f,response:1b,Passengers:[{id:"minecraft:text_display",billboard:"center",alignment:"center",transformation:{translation:[0f,0.5f,0f],scale:[0.8f,0.8f,0.8f],left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f]},text:'{"text":"返回主城","color":"aqua"}'}]}
execute in minecraft:overworld at @e[type=marker,tag=plm_shadow_guide_spot,limit=1] unless entity @e[type=interaction,tag=plm_shadow_guide,distance=..2,limit=1] run summon interaction ~ ~ ~ {Tags:["plm_shadow_guide"],width:1.2f,height:1.6f,response:1b,Passengers:[{id:"minecraft:text_display",billboard:"center",alignment:"center",transformation:{translation:[0f,0.5f,0f],scale:[0.8f,0.8f,0.8f],left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f]},text:'{"text":"影域行记","color":"light_purple"}'}]}
execute in minecraft:overworld at @e[type=marker,tag=plm_shadow_arena_portal_point,limit=1] unless entity @e[type=interaction,tag=plm_shadow_arena_portal,distance=..2,limit=1] run summon interaction ~ ~ ~ {Tags:["plm_shadow_arena_portal"],width:1.4f,height:2f,response:1b,Passengers:[{id:"minecraft:text_display",billboard:"center",alignment:"center",transformation:{translation:[0f,0.5f,0f],scale:[0.85f,0.85f,0.85f],left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f]},text:'{"text":"影主 · 开启挑战","color":"gold"}'}]}
execute in minecraft:overworld at @e[type=marker,tag=plm_shadow_arena_portal_point,limit=1] unless entity @e[type=interaction,tag=plm_shadow_arena_join,distance=..3,limit=1] run summon interaction ~2 ~ ~ {Tags:["plm_shadow_arena_join"],width:1.2f,height:1.8f,response:1b,Passengers:[{id:"minecraft:text_display",billboard:"center",alignment:"center",transformation:{translation:[0f,0.5f,0f],scale:[0.75f,0.75f,0.75f],left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f]},text:'{"text":"影主 · 加入队伍","color":"aqua"}'}]}
