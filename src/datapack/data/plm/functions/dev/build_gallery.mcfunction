# 镜中倒影 · 全量材质展馆（由 src/tools/gen_gallery.py 生成）
# 用法：/function plm:dev/build_gallery
forceload add -32 -32 32 32
gamerule doDaylightCycle false
gamerule doMobSpawning false
time set 6000
weather clear

# 清理旧展品
kill @e[type=item_frame,tag=plm_gallery]
kill @e[type=armor_stand,tag=plm_gallery]

# 地面 / 墙 / 顶
fill -21 99 -21 9 99 1 smooth_quartz
fill -21 100 -21 9 122 -21 gray_concrete
fill -21 100 -21 -21 122 1 gray_concrete
fill 9 100 -21 9 122 1 gray_concrete
fill -21 123 -21 9 123 1 sea_lantern

# 入口标识
setblock -6 100 0 oak_sign{front_text:{messages:['{"text": "镜中倒影 · 材质展厅"}','{"text": "物品框：图标 / 模型"}','{"text": "盔甲架：穿在身上的模型"}','{"text": ""}'],color:"black"}} replace
setblock -6 103 -20 oak_wall_sign[facing=south]{front_text:{messages:['{"text": "全量 71 张贴图 / 71 个模型"}','{"text": "弓与弩的拉弓态：拿在手上拉弓查看"}','{"text": "按钮：领取全套 63 件"}','{"text": ""}'],color:"black"}} replace

