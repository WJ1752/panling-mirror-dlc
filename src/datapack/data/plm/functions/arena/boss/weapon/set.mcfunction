# 6 把 DLC 武器的手持占位（不做技能逻辑）
execute if score #boss mirror_weapon matches 1 run item replace entity @e[tag=mirror_arena_boss,limit=1] weapon.mainhand with minecraft:carrot_on_a_stick{id:"panling:mirror_sword7",CustomModelData:100,Unbreakable:1b,display:{Name:'{"text":"镜·剑","color":"white"}'}}
execute if score #boss mirror_weapon matches 2 run item replace entity @e[tag=mirror_arena_boss,limit=1] weapon.mainhand with minecraft:carrot_on_a_stick{id:"panling:mirror_axe7",CustomModelData:101,Unbreakable:1b,display:{Name:'{"text":"镜·斧","color":"white"}'}}
execute if score #boss mirror_weapon matches 3 run item replace entity @e[tag=mirror_arena_boss,limit=1] weapon.mainhand with minecraft:bow{id:"panling:mirror_bow7",CustomModelData:102,Unbreakable:1b,display:{Name:'{"text":"镜·弓","color":"white"}'}}
execute if score #boss mirror_weapon matches 4 run item replace entity @e[tag=mirror_arena_boss,limit=1] weapon.mainhand with minecraft:crossbow{id:"panling:mirror_crossbow7",CustomModelData:103,Unbreakable:1b,display:{Name:'{"text":"镜·弩","color":"white"}'}}
execute if score #boss mirror_weapon matches 5 run item replace entity @e[tag=mirror_arena_boss,limit=1] weapon.mainhand with minecraft:carrot_on_a_stick{id:"panling:mirror_furnace_twin7",CustomModelData:104,Unbreakable:1b,display:{Name:'{"text":"镜·炉(双)","color":"white"}'}}
execute if score #boss mirror_weapon matches 6 run item replace entity @e[tag=mirror_arena_boss,limit=1] weapon.mainhand with minecraft:carrot_on_a_stick{id:"panling:mirror_furnace_rub7",CustomModelData:105,Unbreakable:1b,display:{Name:'{"text":"镜·炉(拓)","color":"white"}'}}
